---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import RandomPick from '../components/RandomPick.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { CATEGORIES, SITE } from '../consts';
import { getPublishedPosts } from '../utils';

// Brand-anchoring structured data. "הסכתון" is a coined word that looks like an
// inflection of "הסכת", so Google defaults to the dictionary sense. We publish
// BOTH a WebSite and an Organization node (same @id) that explicitly declare
// "הסכתון" as a named entity, list its social profiles (sameAs), and point the
// logo — the strongest on-page signal that this is a brand, not a word.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      name: SITE.title,
      alternateName: [SITE.titleEn, 'הסכתון — תקצירי פודקאסטים'],
      url: SITE.url,
      description: SITE.description,
      inLanguage: 'he-IL',
      publisher: { '@id': `${SITE.url}/#org` },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${SITE.url}/search?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.url}/#org`,
      name: SITE.title,
      alternateName: SITE.titleEn,
      url: SITE.url,
      description: SITE.description,
      logo: `${SITE.url}/favicon.svg`,
      sameAs: [
        SITE.social.instagram,
        'https://x.com/hesketon',
      ].filter(Boolean),
    },
  ],
};

const posts = await getPublishedPosts();

// The random-pick block opens on the hand-picked `featured: true` post (real
// crawlable HTML), then the dice re-rolls it client-side from the full index.
// The initial pick is pulled out of the "הכי חדש" grid so it never shows twice.
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p.id !== featured.id);
const latest = rest.slice(0, 9);

// Ambient waveform for the hero panel.
const heroBars = [
  30, 55, 80, 45, 95, 60, 40, 75, 100, 50, 70, 35, 85, 55, 90, 42, 65, 30, 78, 52, 96, 48, 68, 38,
];
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero__grid reveal">
      <div>
        <p class="eyebrow">תקצירים חכמים · בעברית</p>
        <h1>
          הסכתון — כל מה שחשוב מהפודקאסטים הכי טובים בעולם.
          <span class="hl">בעברית, בכמה דקות.</span>
        </h1>
        <p class="lead">
          האזנה של שעות לא תמיד מסתדרת עם החיים. אנחנו לוקחים את הפרקים הכי טובים ומזקקים מהם את
          העיקר: הרעיונות, התובנות והשורה התחתונה.
        </p>
        <div class="hero__signup">
          <NewsletterForm class="hero__form" />
          <p class="hero__signup-note muted">
            גיליון מזוקק לתיבה. בלי ספאם, ביטול בכל רגע. <a href="/posts/">או פשוט תתחילו לקרוא ←</a>
          </p>
        </div>
      </div>

      <div class="hero__viz" aria-hidden="true">
        <div class="bars">
          {heroBars.map((h) => <span style={`height:${h}%`} />)}
        </div>
        <span class="compress">02:14:00 <span class="arrow">⟶</span> 6′</span>
        <p class="muted" style="text-align:center;margin:0;font-size:0.88rem">מהאוזניים לעיניים</p>
      </div>
    </div>
  </section>

  <RandomPick posts={posts} initial={featured} />

  <section class="section wrap">
    {
      latest.length === 0 ? (
        <p class="muted">
          עדיין אין פוסטים. צרו את הראשון עם <code>npm run new-post</code>.
        </p>
      ) : (
        <>
          <h2 style="margin-bottom:1.6rem">הכי חדש</h2>
          <div class="post-grid">
            {latest.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
          {posts.length > latest.length && (
            <p style="margin-top:2rem">
              <a class="btn btn--ghost" href="/posts/">לכל הפרקים</a>
            </p>
          )}
        </>
      )
    }
  </section>

  <section class="section wrap" style="padding-top:0">
    <h2 style="margin-bottom:1.25rem">לפי נושא</h2>
    <div class="tag-list">
      {CATEGORIES.map((c) => <a class="chip" href={`/categories/${c.slug}/`}>{c.name}</a>)}
    </div>
  </section>
</BaseLayout>
