---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Featured from '../components/Featured.astro';
import { CATEGORIES, SITE } from '../consts';
import { getPublishedPosts } from '../utils';

// Brand-anchoring structured data: tells Google that this domain IS "הסכתון"
// (helps the brand-name query resolve to us) and exposes the site search.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  alternateName: SITE.titleEn,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'he-IL',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${SITE.url}/search?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

const posts = await getPublishedPosts();
const newest = posts[0];

// Hand-picked spotlight: the newest post flagged `featured: true` in its
// frontmatter. Manually controlled — flip the flag to swap it, no schedule.
// It's pulled out of the "הכי חדש" grid below so it never shows twice.
const featured = posts.find((p) => p.data.featured);
const rest = featured ? posts.filter((p) => p.id !== featured.id) : posts;
const latest = rest.slice(0, 9);

// Ambient waveform for the hero panel.
const heroBars = [
  30, 55, 80, 45, 95, 60, 40, 75, 100, 50, 70, 35, 85, 55, 90, 42, 65, 30, 78, 52, 96, 48, 68, 38,
];
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero">
    <div class="wrap hero__grid reveal">
      <div>
        <p class="eyebrow">תקצירים חכמים · בעברית</p>
        <h1>
          כל מה שחשוב מהפודקאסטים הכי טובים בעולם.
          <span class="hl">בעברית, בכמה דקות.</span>
        </h1>
        <p class="lead">
          האזנה של שעות לא תמיד מסתדרת עם החיים. אנחנו לוקחים את הפרקים הכי טובים ומזקקים מהם את
          העיקר: הרעיונות, התובנות והשורה התחתונה.
        </p>
        <div class="hero__cta">
          {newest && <a class="btn" href={`/posts/${newest.id}`}>קראו את האחרון</a>}
          <a class="btn btn--ghost" href="/posts">כל הפרקים</a>
        </div>
      </div>

      <div class="hero__viz" aria-hidden="true">
        <div class="bars">
          {heroBars.map((h) => <span style={`height:${h}%`} />)}
        </div>
        <span class="compress">02:14:00 <span class="arrow">⟶</span> 6′</span>
        <p class="muted" style="text-align:center;margin:0;font-size:0.88rem">מהאוזניים לעיניים</p>
      </div>
    </div>
  </section>

  {featured && <Featured post={featured} />}

  <section class="section wrap">
    {
      latest.length === 0 ? (
        <p class="muted">
          עדיין אין פוסטים. צרו את הראשון עם <code>npm run new-post</code>.
        </p>
      ) : (
        <>
          <h2 style="margin-bottom:1.6rem">הכי חדש</h2>
          <div class="post-grid">
            {latest.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
          {posts.length > latest.length && (
            <p style="margin-top:2rem">
              <a class="btn btn--ghost" href="/posts">לכל הפרקים</a>
            </p>
          )}
        </>
      )
    }
  </section>

  <section class="section wrap" style="padding-top:0">
    <h2 style="margin-bottom:1.25rem">לפי נושא</h2>
    <div class="tag-list">
      {CATEGORIES.map((c) => <a class="chip" href={`/categories/${c.slug}`}>{c.name}</a>)}
    </div>
  </section>
</BaseLayout>
