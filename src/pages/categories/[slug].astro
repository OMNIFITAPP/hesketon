---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES } from '../../consts';
import { getPublishedPosts } from '../../utils';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}

const { category } = Astro.props;
const posts = (await getPublishedPosts()).filter((p) => p.data.category === category.name);
---

<BaseLayout title={category.name} description={category.description}>
  <section class="section wrap">
    <div class="page-title">
      <p class="eyebrow">קטגוריה</p>
      <h1>{category.name}</h1>
      <p class="muted">{category.description}</p>
    </div>
    {
      posts.length === 0 ? (
        <p class="muted">עדיין אין פוסטים בקטגוריה הזו.</p>
      ) : (
        <div class="post-grid">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
