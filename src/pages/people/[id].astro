---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPeopleWithPosts } from '../../utils';

export async function getStaticPaths() {
  const people = await getPeopleWithPosts();
  return people.map(({ person, posts }) => ({
    params: { id: person.id },
    props: { person, posts },
  }));
}

const { person, posts } = Astro.props;

// Search Console: people reach these pages by typing the name, and the old
// "X — כל התקצירים" snippet got almost no clicks. The title says what the page
// gives (their ideas, in Hebrew); the description is built from real data.
const pronoun = person.gender === 'f' ? 'שלה' : person.gender === 'm' ? 'שלו' : null;
const title = pronoun
  ? `${person.nameHe} — הרעיונות ${pronoun} בעברית, מתוך הפודקאסטים`
  : `${person.nameHe} — הרעיונות המרכזיים בעברית, מתוך הפודקאסטים`;

// Lead with a classic if there is one, otherwise the newest summary. Drop a
// leading "Name …:" or trailing "— Name" so the name isn't said twice.
const lead = posts.find((p) => p.data.classic) ?? posts[0];
const nameParts = person.nameHe.replace(/^(ד["״]ר|פרופ['׳])\s+/, '').split(' ');
const leadTitle = lead.data.title
  .replace(new RegExp(`^(${nameParts.join(' ')}|${nameParts.at(-1)})[^:]{0,30}:\\s*`), '')
  .replace(new RegExp(`\\s*—\\s*${person.nameHe}$`), '');
const who = `${person.nameHe}${person.title ? `, ${person.title}` : ''}.`;
const count = posts.length === 1 ? 'תקציר בעברית:' : `${posts.length} תקצירים בעברית, ביניהם:`;
const desc = `${who} ${count} ${leadTitle}${/[.?!]$/.test(leadTitle) ? '' : '.'}`;
---

<BaseLayout title={title} description={desc}>
  <section class="section wrap">
    <div class="page-title">
      <p class="muted person-eyebrow">אורח/ת</p>
      <h1>{person.nameHe}</h1>
      {person.title && <p class="muted">{person.title}</p>}
      <p class="muted">{posts.length === 1 ? 'תקציר אחד' : `${posts.length} תקצירים`} בהסכתון</p>
    </div>
    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
    <p style="margin-top:2rem"><a href="/posts/">← לכל הפרקים</a></p>
  </section>
</BaseLayout>

<style>
  .person-eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    margin-bottom: 0.2rem;
  }
</style>
