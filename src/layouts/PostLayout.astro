---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Compression from '../components/Compression.astro';
import Share from '../components/Share.astro';
import { SITE, categoryByName, tagToSlug, youtubeThumb } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const d = post.data;
const cat = categoryByName(d.category);
const siteUrl = Astro.site ?? new URL(SITE.url);
const url = new URL(`/posts/${post.id}`, siteUrl).href;
const thumb = youtubeThumb(d.source?.youtubeUrl);
const thumbHq = youtubeThumb(d.source?.youtubeUrl, 'hq');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.description,
  inLanguage: 'he-IL',
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  mainEntityOfPage: url,
  author: { '@type': 'Organization', name: SITE.title },
  publisher: { '@type': 'Organization', name: SITE.title },
  ...(d.source?.youtubeUrl ? { isBasedOn: d.source.youtubeUrl } : {}),
  ...(thumb ? { image: thumb } : {}),
};
---

<BaseLayout
  title={d.title}
  description={d.description}
  image={thumb}
  type="article"
  publishedTime={d.pubDate.toISOString()}
  modifiedTime={(d.updatedDate ?? d.pubDate).toISOString()}
  jsonLd={jsonLd}
>
  <article>
    <header class="post-header wrap wrap--reading">
      {cat && <a class="chip" href={`/categories/${cat.slug}`}>{cat.name}</a>}
      <h1>{d.title}</h1>
      <div class="post-meta">
        <Compression audioMinutes={d.source?.durationMinutes} readMinutes={d.readingTime} />
        <FormattedDate date={d.pubDate} />
        {!d.source?.durationMinutes && d.readingTime && (
          <span class="dot">{d.readingTime} דק׳ קריאה</span>
        )}
        {d.source?.podcast && <span class="dot">מבוסס על {d.source.podcast}</span>}
      </div>
    </header>

    {
      thumb && (
        <div class="wrap wrap--reading">
          <a
            class="post-hero"
            href={d.source?.youtubeUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="צפו בפרק המלא ביוטיוב"
          >
            <img
              src={thumb}
              alt={d.title}
              width="1280"
              height="720"
              onerror={`this.onerror=null;this.src='${thumbHq}'`}
            />
            <span class="post-hero__play">
              <svg viewBox="0 0 80 80" aria-hidden="true">
                <circle cx="40" cy="40" r="40" fill="rgba(255,255,255,0.93)" />
                <path d="M33 26l22 14-22 14z" fill="#d6336c" />
              </svg>
            </span>
          </a>
        </div>
      )
    }

    <div class="prose wrap wrap--reading">
      <slot />

      {
        d.source && (
          <aside class="source-box">
            <strong>על מה מבוסס התקציר?</strong>
            <br />
            התקציר מבוסס על
            {d.source.episode ? <> הפרק «{d.source.episode}»</> : <> פרק</>}
            {d.source.podcast ? (
              <>
                {' '}
                מתוך הפודקאסט <strong>{d.source.podcast}</strong>
              </>
            ) : null}
            {d.source.guest ? <> עם {d.source.guest}</> : null}.
            {d.source.youtubeUrl && (
              <>
                {' '}
                <a href={d.source.youtubeUrl} target="_blank" rel="noopener noreferrer">
                  צפו במקור המלא ביוטיוב ↗
                </a>
              </>
            )}
            <br />
            <span class="muted">
              זהו תקציר מקורי ופרשני. כל הזכויות על התוכן המקורי שמורות ליוצרים.
            </span>
          </aside>
        )
      }

      {
        d.tags?.length > 0 && (
          <ul class="tag-list" style="margin-top:1.5rem">
            {d.tags.map((t) => (
              <li>
                <a class="tag" href={`/tags/${tagToSlug(t)}`}>
                  #{t}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <Share title={d.title} url={url} />

      <p style="margin-top:2rem"><a href="/posts">← לכל הפרקים</a></p>
    </div>
  </article>
</BaseLayout>
