---
import { NEWSLETTER, newsletterAction } from '../consts';

// The one signup form, reused by the footer box, the homepage hero and the
// slide-in. Submits silently to the Google Form collector → lands on /thanks.
interface Props {
  /** Extra class on the <form> for context-specific styling. */
  class?: string;
}
const { class: className } = Astro.props;
const action = newsletterAction();
---

{
  action && (
    <form class:list={['nl-form', className]} action={action} method="post" data-newsletter>
      <input
        class="nl-form__input"
        type="email"
        name={NEWSLETTER.emailField}
        required
        placeholder="כתובת אימייל"
        aria-label="כתובת אימייל"
      />
      <button class="nl-form__btn" type="submit">
        {NEWSLETTER.cta}
      </button>
    </form>
  )
}

<script>
  // Silent submit to the Google Form collector, then land on our /thanks page.
  // Google's formResponse accepts cross-origin no-cors posts (no bot challenge
  // — unlike Buttondown's Turnstile). No-JS fallback: native POST, which shows
  // Google's own confirmation page but still records the address.
  document.querySelectorAll<HTMLFormElement>('form[data-newsletter]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'רק רגע…';
      }
      const body = new URLSearchParams();
      new FormData(form).forEach((v, k) => body.append(k, String(v)));
      fetch(form.action, { method: 'POST', body, mode: 'no-cors' })
        .then(() => {
          window.location.href = '/thanks';
        })
        .catch(() => {
          form.submit(); // network hiccup — fall back to the native POST
        });
    });
  });
</script>

<style is:global>
  /* Shared form primitives (global so every usage context can restyle). */
  .nl-form {
    display: flex;
    gap: 0.5rem;
  }
  .nl-form__input {
    flex: 1;
    min-width: 0;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--line, #d9d3c5);
    border-radius: 10px;
    background: var(--bg, #faf8f3);
    font: inherit;
    color: var(--ink, #1a1722);
  }
  .nl-form__input:focus-visible {
    outline: 2px solid var(--accent-ink, #a61e4d);
    outline-offset: 1px;
  }
  .nl-form__btn {
    padding: 0.7rem 1.3rem;
    border: none;
    border-radius: 10px;
    background: var(--accent-ink, #a61e4d);
    color: #fff;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: filter 0.15s ease;
  }
  .nl-form__btn:hover {
    filter: brightness(1.1);
  }
  @media (max-width: 560px) {
    .nl-form {
      flex-direction: column;
      gap: 0.6rem;
    }
    .nl-form__btn {
      width: 100%;
      padding: 0.8rem;
    }
  }
</style>
