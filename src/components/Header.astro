---
import { SITE } from '../consts';
import Wave from './Wave.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      <Wave />
      <span>{SITE.title}</span>
    </a>
    <nav class="nav" aria-label="ניווט ראשי">
      <a href="/posts" aria-current={isActive('/posts') ? 'page' : undefined}>כל הפרקים</a>
      <a href="/categories" aria-current={isActive('/categories') ? 'page' : undefined}>קטגוריות</a>
      <a href="/search" aria-current={isActive('/search') ? 'page' : undefined}>חיפוש</a>
      <a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>אודות</a>
    </nav>
  </div>
</header>
