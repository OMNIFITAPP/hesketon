---
import { SITE } from '../consts';
import Wave from './Wave.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');

const links = [
  { href: '/posts', label: 'כל הפרקים' },
  { href: '/categories', label: 'קטגוריות' },
  { href: '/search', label: 'חיפוש' },
  { href: '/about', label: 'אודות' },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      <Wave />
      <span>{SITE.title}</span>
    </a>

    <button
      class="nav-burger"
      type="button"
      aria-label="פתיחת תפריט"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      <span class="nav-burger__lines" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <nav class="nav" id="site-nav" aria-label="ניווט ראשי">
      {
        links.map((l) => (
          <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      {
        SITE.social.instagram && (
          <a
            class="nav__ig"
            href={SITE.social.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="הסכתון באינסטגרם"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
            <span class="nav__ig-label">אינסטגרם</span>
          </a>
        )
      }
    </nav>
  </div>
</header>

<script>
  // Progressive enhancement: the links are in the DOM regardless (good for SEO
  // and no-JS). This only wires up the mobile overlay open/close behaviour.
  const header = document.querySelector<HTMLElement>('.site-header');
  const burger = header?.querySelector<HTMLButtonElement>('.nav-burger');

  if (header && burger) {
    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'סגירת תפריט' : 'פתיחת תפריט');
      document.body.style.overflow = open ? 'hidden' : '';
    };

    burger.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));

    // Close after picking a destination (covers same-page navigation too).
    header.querySelectorAll('.nav a').forEach((a) =>
      a.addEventListener('click', () => setOpen(false)),
    );

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>
