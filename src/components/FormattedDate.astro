---
interface Props {
  date: Date;
  /** Optional tooltip, e.g. to clarify this is the episode's publish date. */
  title?: string;
  /** Visible label before the date, e.g. 'פרק מ־' when this is an episode's air date. */
  prefix?: string;
}
const { date, title, prefix } = Astro.props;
const formatted = new Intl.DateTimeFormat('he-IL', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(date);
---
<time datetime={date.toISOString()} title={title}>{prefix}{formatted}</time>
