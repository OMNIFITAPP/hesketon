---
import FormattedDate from './FormattedDate.astro';
import Compression from './Compression.astro';
import { categoryByName, youtubeThumb } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const d = post.data;
const cat = categoryByName(d.category);
const audio = d.source?.durationMinutes;
const thumb = youtubeThumb(d.source?.youtubeUrl);
const thumbHq = youtubeThumb(d.source?.youtubeUrl, 'hq');
const episodeDate = d.source?.publishedAt ?? d.pubDate;
const isEpisodeDate = !!d.source?.publishedAt;
const href = `/posts/${post.id}`;
---

<section class="section wrap" style="padding-bottom:0">
  <p class="eyebrow">מומלץ</p>
  <article class="featured">
    {
      thumb && (
        <a class="featured__media" href={href} aria-hidden="true" tabindex="-1">
          <img
            src={thumb}
            alt=""
            loading="lazy"
            decoding="async"
            width="640"
            height="360"
            onerror={`this.onerror=null;this.src='${thumbHq}'`}
          />
        </a>
      )
    }
    <div class="featured__body">
      <div class="featured__top">
        {cat && <a class="chip" href={`/categories/${cat.slug}`}>{cat.name}</a>}
        <Compression audioMinutes={audio} readMinutes={d.readingTime} />
      </div>
      <h2 class="featured__title"><a href={href}>{d.title}</a></h2>
      <p class="featured__desc">{d.description}</p>
      <div class="featured__meta">
        <FormattedDate date={episodeDate} title={isEpisodeDate ? 'תאריך פרסום הפרק' : undefined} />
        {d.source?.podcast && <span class="dot">מתוך «{d.source.podcast}»</span>}
      </div>
    </div>
  </article>
</section>
