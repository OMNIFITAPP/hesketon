---
// "Listen to this post". Two modes:
//   file  — plays a pre-generated MP3 (Google neural voice) with a scrubber
//   tts   — falls back to the browser's Web Speech voice (+ voice picker)
interface Props {
  audioSrc?: string;
}
const { audioSrc } = Astro.props;
---

<div class="listen">
  <button class="listen__btn" type="button" aria-label="האזינו לכתבה">
    <span class="listen__icon" aria-hidden="true">▶</span>
    <span class="listen__label">האזינו לכתבה</span>
  </button>

  {audioSrc && (
    <Fragment>
      <audio class="listen__audio" src={audioSrc} preload="none"></audio>
      <div class="listen__bar" aria-hidden="true"><span></span></div>
      <span class="listen__time">0:00</span>
      <span class="listen__note">קריינות בקול טבעי</span>
    </Fragment>
  )}

  {!audioSrc && (
    <Fragment>
      <label class="listen__voicewrap" hidden>
        <span class="sr-only">בחירת קול</span>
        <select class="listen__voice" aria-label="בחירת קול קריינות"></select>
      </label>
      <span class="listen__note">קריינות אוטומטית (קול המכשיר)</span>
    </Fragment>
  )}
</div>

<script>
  const root = document.querySelector('.listen');
  const btn = root && root.querySelector('.listen__btn');
  const icon = root && root.querySelector('.listen__icon');
  const label = root && root.querySelector('.listen__label');
  const audio = root && root.querySelector('.listen__audio');

  const setLabel = (active, idleText) => {
    if (icon) icon.textContent = active ? '⏸' : '▶';
    if (label) label.textContent = active ? 'השהה' : idleText;
  };

  if (root && btn && audio) {
    // ---- File mode: pre-generated MP3 ----
    const bar = root.querySelector('.listen__bar');
    const fill = bar && bar.querySelector('span');
    const time = root.querySelector('.listen__time');
    const fmt = (s) => {
      if (!isFinite(s)) return '0:00';
      const m = Math.floor(s / 60);
      const sec = String(Math.floor(s % 60)).padStart(2, '0');
      return m + ':' + sec;
    };
    btn.addEventListener('click', () => {
      if (audio.paused) audio.play();
      else audio.pause();
    });
    audio.addEventListener('play', () => setLabel(true, 'האזינו לכתבה'));
    audio.addEventListener('pause', () => setLabel(false, 'האזינו לכתבה'));
    audio.addEventListener('ended', () => setLabel(false, 'האזינו לכתבה'));
    audio.addEventListener('timeupdate', () => {
      if (fill && audio.duration) fill.style.transform = 'scaleX(' + audio.currentTime / audio.duration + ')';
      if (time) time.textContent = fmt(audio.currentTime) + ' / ' + fmt(audio.duration);
    });
    if (bar) {
      bar.addEventListener('click', (e) => {
        if (!audio.duration) return;
        const r = bar.getBoundingClientRect();
        const ratio = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
        audio.currentTime = ratio * audio.duration;
      });
    }
  } else if (root && btn) {
    // ---- TTS fallback: browser speech synthesis ----
    const synth = window.speechSynthesis;
    const select = root.querySelector('.listen__voice');
    const voicewrap = root.querySelector('.listen__voicewrap');
    const KEY = 'hesketon-tts-voice';

    if (!synth) {
      root.setAttribute('hidden', '');
    } else {
      let state = 'idle';
      let chunks = [];
      let voices = [];

      const setState = (s) => {
        state = s;
        if (icon) icon.textContent = s === 'playing' ? '⏸' : '▶';
        if (label) label.textContent = s === 'playing' ? 'השהה' : s === 'paused' ? 'המשך' : 'האזינו לכתבה';
      };

      const loadVoices = () => {
        const all = synth.getVoices();
        const he = all.filter((v) => /^(he|iw)/i.test(v.lang));
        voices = he.length ? he : all;
        if (!select || !voicewrap) return;
        select.innerHTML = '';
        for (const v of voices) {
          const o = document.createElement('option');
          o.value = v.name;
          o.textContent = v.name + (/google/i.test(v.name) ? ' ☁︎' : '');
          select.appendChild(o);
        }
        const saved = localStorage.getItem(KEY);
        let pref = voices[0] && voices[0].name;
        if (saved && voices.some((v) => v.name === saved)) pref = saved;
        else {
          const g = voices.find((v) => /google/i.test(v.name));
          if (g) pref = g.name;
        }
        if (pref) select.value = pref;
        voicewrap.hidden = voices.length <= 1;
      };

      const chosen = () => {
        const name = (select && select.value) || localStorage.getItem(KEY) || '';
        return voices.find((v) => v.name === name) || voices.find((v) => /^(he|iw)/i.test(v.lang)) || null;
      };

      const gather = () => {
        const h1 = document.querySelector('.post-header h1');
        const title = h1 ? h1.textContent.trim() : '';
        const proseEl = document.querySelector('.prose');
        let body = '';
        if (proseEl) {
          const c = proseEl.cloneNode(true);
          c.querySelectorAll('.source-box, .share, .tag-list, .tts-skip').forEach((el) => el.remove());
          body = c.textContent || '';
        }
        return (title + '. ' + body).replace(/\s+/g, ' ').trim();
      };

      const chunkText = (t) => {
        const sents = t.match(/[^.!?]+[.!?]*/g) || [t];
        const out = [];
        let buf = '';
        for (const s of sents) {
          if (buf && (buf + s).length > 220) {
            out.push(buf.trim());
            buf = s;
          } else buf += s;
        }
        if (buf.trim()) out.push(buf.trim());
        return out;
      };

      const speakFrom = (i) => {
        if (i >= chunks.length) {
          setState('idle');
          return;
        }
        const u = new SpeechSynthesisUtterance(chunks[i]);
        u.lang = 'he-IL';
        const v = chosen();
        if (v) u.voice = v;
        u.rate = 0.95;
        u.onend = () => {
          if (state === 'playing') speakFrom(i + 1);
        };
        u.onerror = () => setState('idle');
        synth.speak(u);
      };

      btn.addEventListener('click', () => {
        if (state === 'idle') {
          synth.cancel();
          chunks = chunkText(gather());
          setState('playing');
          speakFrom(0);
        } else if (state === 'playing') {
          synth.pause();
          setState('paused');
        } else {
          synth.resume();
          setState('playing');
        }
      });

      if (select) {
        select.addEventListener('change', () => {
          localStorage.setItem(KEY, select.value);
          if (state !== 'idle') {
            synth.cancel();
            setState('idle');
          }
        });
      }

      if (synth.addEventListener) synth.addEventListener('voiceschanged', loadVoices);
      loadVoices();
      addEventListener('pagehide', () => synth.cancel());
    }
  }
</script>

<style>
  .listen {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 1.3rem 0 0;
  }
  .listen__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: #fff;
    background: var(--accent);
    border: 0;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    cursor: pointer;
    transition: background var(--speed) ease;
  }
  .listen__btn:hover {
    background: var(--accent-ink);
  }
  .listen__icon {
    font-size: 0.78em;
  }
  .listen__bar {
    position: relative;
    width: 150px;
    height: 6px;
    background: var(--accent-soft);
    border-radius: 999px;
    cursor: pointer;
    overflow: hidden;
  }
  .listen__bar span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .listen__time {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .listen__voice {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    max-width: 13rem;
  }
  .listen__note {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
</style>
