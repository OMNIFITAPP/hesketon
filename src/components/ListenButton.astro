---
// "Listen to this post" — free, client-side Text-to-Speech via the Web Speech
// API. Reads the title + body (skips source box, share, tags). Lets the reader
// pick among the device's Hebrew voices. Hides itself if speech is unsupported.
---

<div class="listen">
  <button class="listen__btn" type="button" aria-label="האזינו לכתבה">
    <span class="listen__icon" aria-hidden="true">▶</span>
    <span class="listen__label">האזינו לכתבה</span>
  </button>
  <label class="listen__voicewrap" hidden>
    <span class="sr-only">בחירת קול</span>
    <select class="listen__voice" aria-label="בחירת קול קריינות"></select>
  </label>
  <span class="listen__note">קריינות אוטומטית (קול המכשיר)</span>
</div>

<script>
  const root = document.querySelector<HTMLElement>('.listen');
  const btn = root?.querySelector<HTMLButtonElement>('.listen__btn');
  const icon = root?.querySelector<HTMLElement>('.listen__icon');
  const label = root?.querySelector<HTMLElement>('.listen__label');
  const select = root?.querySelector<HTMLSelectElement>('.listen__voice');
  const voicewrap = root?.querySelector<HTMLElement>('.listen__voicewrap');
  const synth = window.speechSynthesis;
  const KEY = 'hesketon-tts-voice';

  if (!root || !btn || !synth) {
    root?.setAttribute('hidden', '');
  } else {
    let state: 'idle' | 'playing' | 'paused' = 'idle';
    let chunks: string[] = [];
    let voices: SpeechSynthesisVoice[] = [];

    const setState = (s: typeof state) => {
      state = s;
      if (icon) icon.textContent = s === 'playing' ? '⏸' : '▶';
      if (label) label.textContent = s === 'playing' ? 'השהה' : s === 'paused' ? 'המשך' : 'האזינו לכתבה';
    };

    const loadVoices = () => {
      const all = synth.getVoices();
      const he = all.filter((v) => /^(he|iw)/i.test(v.lang));
      voices = he.length ? he : all;
      if (!select || !voicewrap) return;
      select.innerHTML = '';
      for (const v of voices) {
        const o = document.createElement('option');
        o.value = v.name;
        o.textContent = v.name + (/google/i.test(v.name) ? ' ☁︎' : '');
        select.appendChild(o);
      }
      const saved = localStorage.getItem(KEY);
      const preferred =
        (saved && voices.some((v) => v.name === saved) && saved) ||
        voices.find((v) => /google/i.test(v.name))?.name ||
        voices[0]?.name;
      if (preferred) select.value = preferred;
      voicewrap.hidden = voices.length <= 1;
    };

    const chosenVoice = (): SpeechSynthesisVoice | null => {
      const name = select?.value || localStorage.getItem(KEY) || '';
      return (
        voices.find((v) => v.name === name) ||
        voices.find((v) => /^(he|iw)/i.test(v.lang)) ||
        null
      );
    };

    const gatherText = (): string => {
      const title = document.querySelector('.post-header h1')?.textContent?.trim() ?? '';
      const proseEl = document.querySelector('.prose');
      let body = '';
      if (proseEl) {
        const clone = proseEl.cloneNode(true) as HTMLElement;
        clone.querySelectorAll('.source-box, .share, .tag-list, .tts-skip').forEach((el) => el.remove());
        body = clone.textContent ?? '';
      }
      return `${title}. ${body}`.replace(/\s+/g, ' ').trim();
    };

    const chunkText = (t: string): string[] => {
      const sentences = t.match(/[^.!?]+[.!?]*/g) ?? [t];
      const out: string[] = [];
      let buf = '';
      for (const s of sentences) {
        if ((buf + s).length > 220 && buf) {
          out.push(buf.trim());
          buf = s;
        } else buf += s;
      }
      if (buf.trim()) out.push(buf.trim());
      return out;
    };

    const speakFrom = (i: number) => {
      if (i >= chunks.length) return setState('idle');
      const u = new SpeechSynthesisUtterance(chunks[i]);
      u.lang = 'he-IL';
      const v = chosenVoice();
      if (v) u.voice = v;
      u.rate = 0.95;
      u.onend = () => {
        if (state === 'playing') speakFrom(i + 1);
      };
      u.onerror = () => setState('idle');
      synth.speak(u);
    };

    btn.addEventListener('click', () => {
      if (state === 'idle') {
        synth.cancel();
        chunks = chunkText(gatherText());
        setState('playing');
        speakFrom(0);
      } else if (state === 'playing') {
        synth.pause();
        setState('paused');
      } else {
        synth.resume();
        setState('playing');
      }
    });

    select?.addEventListener('change', () => {
      localStorage.setItem(KEY, select.value);
      if (state !== 'idle') {
        synth.cancel();
        setState('idle');
      }
    });

    synth.addEventListener?.('voiceschanged', loadVoices);
    loadVoices();
    addEventListener('pagehide', () => synth.cancel());
  }
</script>

<style>
  .listen {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin: 1.3rem 0 0;
  }
  .listen__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: #fff;
    background: var(--accent);
    border: 0;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    cursor: pointer;
    transition: background var(--speed) ease;
  }
  .listen__btn:hover {
    background: var(--accent-ink);
  }
  .listen__icon {
    font-size: 0.78em;
  }
  .listen__voice {
    font-family: var(--font-body);
    font-size: 0.85rem;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    max-width: 13rem;
  }
  .listen__note {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
</style>
