---
import { NEWSLETTER, newsletterAction } from '../consts';
import NewsletterForm from './NewsletterForm.astro';

// The footer signup box. Renders only when the collector is configured.
// Hidden on the post-signup page — offering signup right after signing up is silly.
const onThanks = (Astro.url.pathname.replace(/\/$/, '') || '/') === '/thanks';
const enabled = newsletterAction().length > 0 && !onThanks;
---

{
  enabled && (
    <aside class="newsletter">
      <div class="newsletter__text">
        <p class="newsletter__heading">{NEWSLETTER.heading}</p>
        <p class="newsletter__subtext">{NEWSLETTER.subtext}</p>
      </div>
      <NewsletterForm class="newsletter__form" />
    </aside>
  )
}

<style>
  .newsletter {
    margin: 3rem 0 1rem;
    padding: 1.6rem 1.8rem;
    border: 1px solid var(--line, #e7e2d6);
    border-radius: 14px;
    background: var(--accent-soft, #fbe0ea);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
  }
  .newsletter__heading {
    font-family: var(--font-display, 'Rubik', sans-serif);
    font-weight: 700;
    font-size: 1.15rem;
    margin: 0 0 0.25rem;
    color: var(--ink, #1a1722);
  }
  .newsletter__subtext {
    margin: 0;
    font-size: 0.9rem;
    color: var(--muted, #6b6577);
  }
  .newsletter :global(.newsletter__form) {
    flex: 1 1 280px;
    max-width: 420px;
  }
  @media (max-width: 560px) {
    .newsletter {
      flex-direction: column;
      align-items: stretch;
      padding: 1.3rem 1.3rem 1.4rem;
    }
    .newsletter :global(.newsletter__form) {
      max-width: none;
      flex: none;
    }
  }
</style>
