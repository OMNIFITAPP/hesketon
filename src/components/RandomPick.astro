---
// "לא יודעים מה לקרוא?" — the featured block, upgraded to a random picker.
// Server renders the hand-picked (featured:true) post as real crawlable HTML;
// with JS, an inline script swaps it pre-paint for the "ghost card" — the
// dormant hesketon mascot (בועת ההסכת) — so nothing shows until the reader
// asks. Any chip / the dice / the ghost itself rolls: the mascot dances
// (1.5s first roll, 0.6s after, none under reduced-motion), then a random
// card is revealed from the inlined post index.
// Filter chips: all / classics (gold) / categories. Filter choice persists in
// localStorage; every roll fires an Umami event so we can see usage.
import FormattedDate from './FormattedDate.astro';
import ClassicTag from './ClassicTag.astro';
import { CATEGORIES, categoryByName, youtubeThumb } from '../consts';
import { bestThumb } from '../lib/thumbs';
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'posts'>[];
  initial: CollectionEntry<'posts'>;
}
const { posts, initial } = Astro.props;

const dateFmt = new Intl.DateTimeFormat('he', { day: 'numeric', month: 'long', year: 'numeric' });
const fmtAudio = (min: number) => {
  const h = Math.floor(min / 60);
  const m = min % 60;
  return h ? `${h}:${String(m).padStart(2, '0')}:00` : `${m}:00`;
};

// Compact index for client-side rolling (only what the card renders).
// thumb is build-time resolved so a re-roll never lands on a 404 (older
// videos have no maxresdefault); bestThumb caches per id, so this is one
// HEAD per unique video across the whole build.
const index = await Promise.all(
  posts.map(async (p) => {
    const d = p.data;
    const cat = categoryByName(d.category);
    const date = d.source?.publishedAt ?? d.pubDate;
    return {
      slug: p.id,
      title: d.title,
      desc: d.description,
      cat: d.category,
      catSlug: cat?.slug ?? '',
      thumb: (await bestThumb(d.source?.youtubeUrl)) ?? '',
      thumbHq: youtubeThumb(d.source?.youtubeUrl, 'hq') ?? '',
      audio: d.source?.durationMinutes ?? 0,
      read: d.readingTime ?? 0,
      date: dateFmt.format(date),
      podcast: d.source?.podcast ?? '',
      classic: !!d.classic,
    };
  }),
);
const indexJson = JSON.stringify(index).replace(/</g, '\\u003c');

// Chips: only filters that can actually return something.
const classicsCount = index.filter((p) => p.classic).length;
const catChips = CATEGORIES.filter((c) => index.some((p) => p.cat === c.name));

// Initial (server-rendered) card = the hand-picked featured post.
const d = initial.data;
const cat = categoryByName(d.category);
const audio = d.source?.durationMinutes;
const thumb = await bestThumb(d.source?.youtubeUrl);
const thumbHq = youtubeThumb(d.source?.youtubeUrl, 'hq');
const episodeDate = d.source?.publishedAt ?? d.pubDate;
const href = `/posts/${initial.id}`;
---

<section class="section wrap" style="padding-bottom:0" data-pick>
  <div class="pick__bar">
    <p class="eyebrow" style="margin:0">לא יודעים מה לקרוא?</p>
    <div class="pick__chips" data-pick-chips hidden>
      <button class="pick-chip" type="button" data-filter="all" aria-pressed="true">הכול</button>
      {classicsCount > 0 && (
        <button class="pick-chip pick-chip--classic" type="button" data-filter="classic" aria-pressed="false">
          קלאסיקות
        </button>
      )}
      {catChips.map((c) => (
        <button class="pick-chip" type="button" data-filter={`cat:${c.name}`} aria-pressed="false">
          {c.name}
        </button>
      ))}
      <button class="pick__roll" type="button" data-pick-roll>🎲 הגרילו לי פרק</button>
    </div>
  </div>

  <button class="pick__ghost" type="button" data-pick-ghost hidden>
    <svg class="hsk" viewBox="0 0 110 96" width="150" height="131" aria-hidden="true">
      <g class="hsk__body">
        <rect x="22" y="12" width="66" height="68" rx="26" fill="var(--accent)"></rect>
        <circle cx="36" cy="52" r="4.5" fill="#fff" opacity=".22"></circle>
        <circle cx="74" cy="52" r="4.5" fill="#fff" opacity=".22"></circle>
        <g class="hsk__eye">
          <circle cx="43" cy="40" r="3.5" fill="#1a1722"></circle>
          <circle cx="44.3" cy="38.8" r="1.1" fill="#fff"></circle>
        </g>
        <g class="hsk__eye hsk__eye--b">
          <circle cx="67" cy="40" r="3.5" fill="#1a1722"></circle>
          <circle cx="68.3" cy="38.8" r="1.1" fill="#fff"></circle>
        </g>
        <rect class="hsk__mbar" style="animation-delay:-0.1s" x="48" y="51" width="3.5" height="10" rx="1.75" fill="#1a1722"></rect>
        <rect class="hsk__mbar" style="animation-delay:-0.35s" x="53.5" y="48" width="3.5" height="16" rx="1.75" fill="#1a1722"></rect>
        <rect class="hsk__mbar" style="animation-delay:-0.6s" x="59" y="52" width="3.5" height="9" rx="1.75" fill="#1a1722"></rect>
      </g>
    </svg>
    <span class="pick__ghost-hint" data-ghost-hint>בחרו קטגוריה או הגרילו 🎲</span>
  </button>

  <article class:list={['featured', 'pick__card', d.classic && 'featured--classic']} data-pick-card>
    <a
      class="featured__media"
      href={href}
      aria-hidden="true"
      tabindex="-1"
      data-pk="media"
      hidden={!thumb}
    >
      <img
        src={thumb}
        alt=""
        loading="lazy"
        decoding="async"
        width="640"
        height="360"
        data-pk="img"
        onerror="this.onerror=null;if(this.dataset.hq)this.src=this.dataset.hq"
        data-hq={thumbHq}
      />
    </a>
    <div class="featured__body">
      <div class="featured__top">
        <span class="card__chips">
          <a class="chip" href={cat ? `/categories/${cat.slug}` : '#'} data-pk="cat">{cat?.name ?? d.category}</a>
          <ClassicTag class="pick__classic" hidden={!d.classic} />
        </span>
        <span
          class="compress"
          role="img"
          data-pk="comp"
          hidden={!(audio && d.readingTime)}
        >
          <span class="wave" aria-hidden="true">
            <span style="height:40%"></span><span style="height:72%"></span><span style="height:100%"
            ></span><span style="height:52%"></span><span style="height:84%"></span><span style="height:44%"></span>
          </span>
          <span data-pk="audio">{audio ? fmtAudio(audio) : ''}</span>
          <span class="arrow">⟶</span>
          <span data-pk="read">{d.readingTime ?? ''}′</span>
        </span>
      </div>
      <h2 class="featured__title"><a href={href} data-pk="title">{d.title}</a></h2>
      <p class="featured__desc" data-pk="desc">{d.description}</p>
      <div class="featured__meta">
        <time data-pk="date">{dateFmt.format(episodeDate)}</time>
        <span class="dot" data-pk="podcast" hidden={!d.source?.podcast}>מתוך «{d.source?.podcast}»</span>
      </div>
    </div>
  </article>
</section>

<!-- runs during parse, before this region paints: crawlers and no-JS readers
     keep the server-rendered featured card, everyone else starts at the ghost -->
<script is:inline>
  {
    const s = document.querySelector('[data-pick]');
    const c = s && s.querySelector('[data-pick-card]');
    const g = s && s.querySelector('[data-pick-ghost]');
    if (c && g) {
      c.hidden = true;
      g.hidden = false;
    }
  }
</script>

<script type="application/json" id="pick-index" set:html={indexJson} />

<script>
  const root = document.querySelector<HTMLElement>('[data-pick]');
  const indexEl = document.getElementById('pick-index');
  if (root && indexEl) {
    type P = {
      slug: string; title: string; desc: string; cat: string; catSlug: string;
      thumb: string; thumbHq: string; audio: number; read: number;
      date: string; podcast: string; classic: boolean;
    };
    const posts: P[] = JSON.parse(indexEl.textContent || '[]');
    const card = root.querySelector<HTMLElement>('[data-pick-card]')!;
    const ghost = root.querySelector<HTMLButtonElement>('[data-pick-ghost]')!;
    const hint = root.querySelector<HTMLElement>('[data-ghost-hint]')!;
    const chipsWrap = root.querySelector<HTMLElement>('[data-pick-chips]')!;
    const rollBtn = root.querySelector<HTMLButtonElement>('[data-pick-roll]')!;
    const q = (k: string) => root.querySelector<HTMLElement>(`[data-pk="${k}"]`)!;

    chipsWrap.hidden = false; // chips + dice only make sense with JS

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let filter = localStorage.getItem('hsk-pick-filter') || 'all';
    let current = ''; // slug currently shown (initial is the featured post)
    let rolled = false; // first roll earns the full mascot dance
    let timer = 0;

    const pool = () =>
      posts.filter((p) =>
        filter === 'all' ? true : filter === 'classic' ? p.classic : p.cat === filter.slice(4),
      );

    const applyChips = () => {
      chipsWrap.querySelectorAll<HTMLButtonElement>('.pick-chip').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.filter === filter));
      });
    };
    // restore a saved filter only if it still exists as a chip
    if (![...chipsWrap.querySelectorAll<HTMLElement>('.pick-chip')].some((b) => b.dataset.filter === filter)) {
      filter = 'all';
    }
    applyChips();

    const fmtAudio = (min: number) => {
      const h = Math.floor(min / 60);
      const m = min % 60;
      return h ? `${h}:${String(m).padStart(2, '0')}:00` : `${m}:00`;
    };

    const render = (p: P) => {
      const href = `/posts/${p.slug}`;
      const media = q('media') as HTMLAnchorElement;
      const img = q('img') as HTMLImageElement;
      if (p.thumb) {
        media.hidden = false;
        media.href = href;
        img.dataset.hq = p.thumbHq;
        img.src = p.thumb;
      } else {
        media.hidden = true;
      }
      const cat = q('cat') as HTMLAnchorElement;
      cat.textContent = p.cat;
      cat.href = p.catSlug ? `/categories/${p.catSlug}` : '#';
      const comp = q('comp');
      if (p.audio && p.read) {
        comp.hidden = false;
        q('audio').textContent = fmtAudio(p.audio);
        q('read').textContent = `${p.read}′`;
      } else {
        comp.hidden = true;
      }
      const title = q('title') as HTMLAnchorElement;
      title.textContent = p.title;
      title.href = href;
      q('desc').textContent = p.desc;
      q('date').textContent = p.date;
      const pod = q('podcast');
      pod.hidden = !p.podcast;
      pod.textContent = p.podcast ? `מתוך «${p.podcast}»` : '';
      const tag = root.querySelector<HTMLElement>('.pick__classic')!;
      tag.hidden = !p.classic;
      card.classList.toggle('featured--classic', p.classic);
      current = p.slug;
    };

    const roll = () => {
      const candidates = pool().filter((p) => p.slug !== current);
      const list = candidates.length ? candidates : pool();
      if (!list.length) return;
      const next = list[Math.floor(Math.random() * list.length)];
      const delay = reduced ? 0 : rolled ? 600 : 1500;
      rolled = true;
      card.hidden = true;
      ghost.hidden = false;
      ghost.disabled = true;
      ghost.classList.add('is-rolling');
      hint.textContent = 'ההסכתון בוחר לכם פרק…';
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        render(next);
        ghost.classList.remove('is-rolling');
        ghost.disabled = false;
        ghost.hidden = true;
        card.hidden = false;
        card.classList.remove('is-revealing');
        void card.offsetWidth; // restart the reveal animation on every roll
        card.classList.add('is-revealing');
      }, delay);
      rollBtn.textContent = '🎲 עוד אחד';
      (window as any).umami?.track?.('random-pick', { filter });
    };

    rollBtn.addEventListener('click', roll);
    ghost.addEventListener('click', roll);
    chipsWrap.querySelectorAll<HTMLButtonElement>('.pick-chip').forEach((b) =>
      b.addEventListener('click', () => {
        filter = b.dataset.filter || 'all';
        localStorage.setItem('hsk-pick-filter', filter);
        applyChips();
        roll(); // picking a filter immediately delivers a pick — no second tap
      }),
    );
  }
</script>

<style is:global>
  /* when a rolled post has no thumbnail, let the body take the full card */
  .featured:has(.featured__media[hidden]) {
    grid-template-columns: 1fr;
  }
</style>
