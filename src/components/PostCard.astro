---
import FormattedDate from './FormattedDate.astro';
import Compression from './Compression.astro';
import { categoryByName, youtubeThumb } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const d = post.data;
const cat = categoryByName(d.category);
const audio = d.source?.durationMinutes;
const thumb = youtubeThumb(d.source?.youtubeUrl);
const thumbHq = youtubeThumb(d.source?.youtubeUrl, 'hq');
// Prefer the episode's own publish date over when we posted the summary.
const episodeDate = d.source?.publishedAt ?? d.pubDate;
const isEpisodeDate = !!d.source?.publishedAt;
---

<article
  class="card"
  data-category={d.category}
  data-date={episodeDate.toISOString()}
  data-guest={d.source?.guest}
  data-podcast={d.source?.podcast}
>
  {
    thumb && (
      <div class="card__media">
        <img
          src={thumb}
          alt={d.title}
          loading="lazy"
          decoding="async"
          width="640"
          height="360"
          onerror={`this.onerror=null;this.src='${thumbHq}'`}
        />
      </div>
    )
  }
  <div class="card__top">
    <span class="card__chips">
      {cat && <a class="chip" href={`/categories/${cat.slug}`}>{cat.name}</a>}
      {d.premium && <span class="premium-tag">✦ פרימיום</span>}
    </span>
    <Compression audioMinutes={audio} readMinutes={d.readingTime} />
  </div>
  <h2 class="card__title"><a href={`/posts/${post.id}`}>{d.title}</a></h2>
  <p class="card__desc">{d.description}</p>
  <div class="card__meta">
    <FormattedDate date={episodeDate} title={isEpisodeDate ? 'תאריך פרסום הפרק' : undefined} />
    {!audio && d.readingTime && <span class="dot">{d.readingTime} דק׳ קריאה</span>}
  </div>
</article>
