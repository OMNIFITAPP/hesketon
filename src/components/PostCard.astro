---
import FormattedDate from './FormattedDate.astro';
import Compression from './Compression.astro';
import { categoryByName, youtubeThumb } from '../consts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}
const { post } = Astro.props;
const d = post.data;
const cat = categoryByName(d.category);
const audio = d.source?.durationMinutes;
const thumb = youtubeThumb(d.source?.youtubeUrl);
const thumbHq = youtubeThumb(d.source?.youtubeUrl, 'hq');
---

<article class="card">
  {
    thumb && (
      <div class="card__media">
        <img
          src={thumb}
          alt={d.title}
          loading="lazy"
          decoding="async"
          width="640"
          height="360"
          onerror={`this.onerror=null;this.src='${thumbHq}'`}
        />
      </div>
    )
  }
  <div class="card__top">
    {cat ? <a class="chip" href={`/categories/${cat.slug}`}>{cat.name}</a> : <span></span>}
    <Compression audioMinutes={audio} readMinutes={d.readingTime} />
  </div>
  <h2 class="card__title"><a href={`/posts/${post.id}`}>{d.title}</a></h2>
  <p class="card__desc">{d.description}</p>
  <div class="card__meta">
    <FormattedDate date={d.pubDate} />
    {!audio && d.readingTime && <span class="dot">{d.readingTime} דק׳ קריאה</span>}
  </div>
</article>
