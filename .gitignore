# dependencies
node_modules/

# build output
dist/
.astro/

# environment / secrets — never commit these
.env
.env.local
.env.*.local

# OS / editor cruft
.DS_Store
*.log
npm-debug.log*
.vscode/
.idea/

# Local transcripts stay private — keep them out of the public repo.
# (Only the README and the example brief are tracked.)
inbox/**/*.md
!inbox/README.md
!inbox/_example-episode.md
# transcripts in any format stay local too
inbox/**/*.txt
inbox/**/*.vtt
inbox/**/*.srt

# Local-only social render previews (the real, deployable assets live in
# public/social/ and ARE tracked so the Meta API can fetch them by URL).
.social-preview/

# Share-kit output (story PNG + caption per post) — ephemeral, sent by hand
# via WhatsApp/AirDrop; regenerate any time with `npm run share <slug>`.
share-kit/
.generation-report.md
