# ──────────────────────────────────────────────────────────────
#  Copy this file to ".env" and fill in your keys.
#  ".env" is git-ignored and never leaves your machine.
# ──────────────────────────────────────────────────────────────

# Anthropic API key — required to generate posts.
# Get one at: https://console.anthropic.com  →  Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which Claude model writes the posts.
#   claude-sonnet-4-6  → excellent quality, cheaper & faster (default)
#   claude-opus-4-8    → top quality, costs more (use for flagship posts)
CLAUDE_MODEL=claude-sonnet-4-6

# Hebrew copy-editor pass — a second, cheap call that polishes the draft's
# Hebrew (it never re-reads the transcript). On by default; set to "false"
# to skip. EDITOR_MODEL overrides which model edits (defaults to CLAUDE_MODEL).
EDITOR_PASS=true
EDITOR_MODEL=

# Quote-fidelity pass — checks each quote is a faithful, full translation of
# its verbatim English source (the writer supplies it) and rewrites paraphrases.
# Cheap (no transcript re-read). QUOTE_AUDIT leaves an invisible source trail in
# the .md for easy human verification. Set either to "false" to disable.
QUOTE_GROUNDING=true
QUOTE_AUDIT=true

# Apify actor: now defaults to a Whisper-capable one (captions + AI fallback).
APIFY_ACTOR=codepoetry~youtube-transcript-ai-scraper

# ──── Phase 2 (optional) — automatic YouTube transcript scraping ────
# Until you set these, just paste the transcript into the inbox brief.

# Apify token — https://console.apify.com/account/integrations
APIFY_TOKEN=

# (APIFY_ACTOR default is set above — captions + Whisper AI fallback.)
