# ──────────────────────────────────────────────────────────────
#  Copy this file to ".env" and fill in your keys.
#  ".env" is git-ignored and never leaves your machine.
# ──────────────────────────────────────────────────────────────

# Anthropic API key — required to generate posts.
# Get one at: https://console.anthropic.com  →  Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which Claude model writes the posts.
#   claude-sonnet-4-6  → excellent quality, cheaper & faster (default)
#   claude-opus-4-8    → top quality, costs more (use for flagship posts)
CLAUDE_MODEL=claude-sonnet-4-6

# ──── Phase 2 (optional) — automatic YouTube transcript scraping ────
# Until you set these, just paste the transcript into the inbox brief.

# Apify token — https://console.apify.com/account/integrations
APIFY_TOKEN=

# An Apify actor that returns a YouTube transcript. Pick one from the
# Apify Store and put its id here (format: username~actor-name).
APIFY_ACTOR=pintostudio~youtube-transcript-scraper

# ──── Natural "listen" voice (optional) — Google Cloud Text-to-Speech ────
# Enable the "Cloud Text-to-Speech API" in a Google Cloud project and create
# an API key. Free tier covers ~1M characters/month. Without this, posts use
# the browser's built-in voice as a fallback.
GOOGLE_TTS_API_KEY=
# he-IL voice. Neural2 if available, else a WaveNet voice (e.g. he-IL-Wavenet-C).
GOOGLE_TTS_VOICE=he-IL-Neural2-B
