{
  "name": "hesketon",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "הסכתון — תקצירים חכמים ומקוריים מהפודקאסטים הכי טובים, בעברית.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "fetch": "node scripts/fetch-transcript.mjs",
    "resolve-name": "node scripts/resolve-name.mjs",
    "check-names": "node scripts/check-names.mjs",
    "check:reviews": "node scripts/check-reviews.mjs",
    "check:transcript": "node scripts/check-transcript.mjs",
    "check:units": "node scripts/check-units.mjs",
    "check:thumbs": "node scripts/check-thumbs.mjs",
    "new-post": "node scripts/generate.mjs",
    "new-post:dry": "node scripts/generate.mjs --dry-run",
    "check:refs": "node scripts/check-references.mjs",
    "share": "node scripts/share-kit.mjs",
    "social": "node scripts/social.mjs",
    "social:dry": "node scripts/social.mjs --dry-run",
    "social:publish": "node scripts/publish-social.mjs",
    "social:publish:dry": "node scripts/publish-social.mjs --dry-run",
    "postbuild": "pagefind --site dist",
    "check:refs:verify": "node scripts/check-references.mjs --verify",
    "check:style": "node scripts/check-style.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^6.4.8"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.2.0",
    "pagefind": "^1.5.2",
    "puppeteer": "^24.10.0",
    "qrcode": "^1.5.4",
    "youtube-transcript": "^1.3.1"
  }
